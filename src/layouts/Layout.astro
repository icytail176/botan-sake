---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { withBase } from '../lib/catalog';
import config from '../../data/site.json';
interface Props { title?: string; description?: string; active?: 'home' | 'catalog' | 'about'; image?: string; canonicalPath?: string; noindex?: boolean }
const { title = 'ぼたんの酒手帖', description = '『上伊那ぼたん、酔へる姿は百合の花』に登場するお酒を、ひとつずつ記録する非公式の酒図鑑。', active = 'catalog', image, canonicalPath, noindex = false } = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" /><meta name="theme-color" content="#f7f6f2" />
    <title>{title === 'ぼたんの酒手帖' ? title : `${title} | ぼたんの酒手帖`}</title><meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:locale" content="ja_JP" /><meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(withBase(image), Astro.site)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header wrap">
      <a class="brand" href={withBase()} aria-label="ぼたんの酒手帖 ホーム"><span class="brand-mark"><Mark /></span><span>ぼたんの酒手帖<small>BOTAN’S SAKE NOTEBOOK</small></span></a>
      <nav aria-label="メインナビゲーション"><a href={withBase()} aria-current={active === 'home' ? 'page' : undefined}>ホーム</a><a href={withBase('#catalog')} class:list={{ 'is-active': active === 'catalog' }} aria-current={active === 'catalog' ? 'page' : undefined}>酒図鑑</a><a href={withBase('about/')} aria-current={active === 'about' ? 'page' : undefined}>この手帖について</a></nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap"><div><a class="footer-brand" href={withBase()}>ぼたんの酒手帖</a><p>物語に登場するお酒を、ひとつずつ。</p></div><div class="footer-note"><p>『上伊那ぼたん、酔へる姿は百合の花』非公式ファンサイト</p><p>作品・商品画像の権利は各権利者に帰属します。</p><a href={withBase('about/')}>出典・このサイトについて <span aria-hidden="true">↗</span></a>{config.contactEmail && <a href={`mailto:${config.contactEmail}`}>お問い合わせ</a>}</div><small class="footer-end">BOTAN’S SAKE NOTEBOOK <span>個人による資料アーカイブ</span></small></footer>
  </body>
</html>
